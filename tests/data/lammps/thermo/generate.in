# Regenerates log.lammps and dump.lammpstrj in this directory (LAMMPS >= 2024, run from here):
#   lmp -in generate.in -log log.lammps
# Two runs with different thermo columns; thermo every 5 steps, dump every 10.
units           metal
atom_style      atomic
boundary        p p p
lattice         fcc 3.615
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 63.546
pair_style      lj/cut 5.0
pair_coeff      * * 0.4 2.3
velocity        all create 600 87287 loop geom
timestep        0.002
fix             1 all nve
thermo          5
thermo_style    custom step temp pe ke etotal press
dump            d1 all custom 10 dump.lammpstrj id type x y z fx fy fz
run             20
thermo_style    custom step temp pe press vol c_thermo_press[1]
run             20
